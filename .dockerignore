# Build context for the app image (Dockerfile). Keep secrets and local state OUT of the image.

# Secrets / environment (the containers get them at runtime via env_file)
# (`**/` so a stray copy in any sub-folder is excluded too; patterns are root-relative otherwise)
**/.env
**/.env.*
!.env.example
secrets/
.secrets/
**/*.pem
**/*.key
**/id_rsa*
**/id_ecdsa*
**/id_ed25519*
**/deploy_key*
ops/secrets.env.enc

# Dependencies and build output (rebuilt inside the image)
node_modules/
.next/
dist/
out/
build/
*.tsbuildinfo
next-env.d.ts

# VCS / editor / OS
.git/
.github/
.gitignore
.vscode/
.idea/
.DS_Store
*.swp

# Local databases, dumps, backups
.data/
**/*.sql.gz
**/*.enc
**/*.dump
ops/backup/

# Tests and their artefacts
tests/
coverage/
playwright-report/
test-results/
blob-report/
.vitest/
*.log
npm-debug.log*

# Claude / agent notes
.claude/
