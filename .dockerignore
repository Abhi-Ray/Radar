# Build context for the app image (Dockerfile). Keep secrets and local state OUT of the image.

# Secrets / environment (the containers get them at runtime via env_file)
.env
.env.*
!.env.example
secrets/
.secrets/
*.pem
*.key
id_*
ops/secrets.env.enc

# Dependencies and build output (rebuilt inside the image)
node_modules/
.next/
dist/
out/
build/
*.tsbuildinfo
next-env.d.ts

# VCS / editor / OS
.git/
.github/
.gitignore
.vscode/
.idea/
.DS_Store
*.swp

# Local databases, dumps, backups
.data/
*.sql.gz
*.enc
*.dump
ops/backup/

# Tests and their artefacts
tests/
coverage/
playwright-report/
test-results/
blob-report/
.vitest/
*.log
npm-debug.log*

# Claude / agent notes
.claude/
