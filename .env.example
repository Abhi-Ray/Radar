# RADAR environment: every key, no values. This file is public; the real .env never is.
#
# Production: /opt/radar/.env (mode 600), read by docker compose. Create it with
#   sudo ops/secrets.sh init --domain radar.<ip-with-dashes>.sslip.io --email you@example.com
# (fills DOMAIN, APP_URL, ADMIN_EMAIL and generates every secret), then fill in the optional keys.
# Keep an encrypted copy in git: sudo ops/secrets.sh encrypt  (→ ops/secrets.env.enc, docs/DEPLOY.md).
# Local development uses .env.local (DATABASE_URL, ADMIN_*, SESSION_SECRET, APP_URL).
#
# Rules: one KEY=VALUE per line, no spaces around '=', no `export`. Leave a key empty to use its
# default. Docker compose interpolates '$' in values, so generated secrets use [0-9a-f] only
# (and MYSQL_* must match [A-Za-z0-9_-]: they are embedded in DATABASE_URL).

# ─── Public name ────────────────────────────────────────────────────────────────────────────
# Host name of the nginx vhost + Let's Encrypt certificate, e.g. radar.187-127-129-127.sslip.io.
# ops/install.sh --domain auto derives radar.<this VPS's IPv4 with dashes>.sslip.io.
DOMAIN=
# Public base URL, exactly https://<DOMAIN> (no trailing slash). Used for the session cookie,
# the CSRF Origin check and links in alerts.
APP_URL=

# ─── Login (single user) ────────────────────────────────────────────────────────────────────
# The only account's email address; also the Let's Encrypt contact unless --email is given.
ADMIN_EMAIL=
# scrypt:N:r:p:<salt>:<key> — NEVER the password itself. Generate it with
#   docker compose run --rm --no-deps app hash-password      (production; prompts, no echo)
#   npx tsx scripts/hash-password.ts                          (development)
# ops/install.sh offers to create it when empty.
ADMIN_PASSWORD_HASH=
# HS256 key for the session JWT, at least 32 characters (openssl rand -hex 32).
# Changing it logs every session out.
SESSION_SECRET=

# ─── Time ───────────────────────────────────────────────────────────────────────────────────
# IANA zone for display, digests and reminders (the database always stores UTC).
# Default: Asia/Kolkata.
APP_TZ=

# ─── Database (the `mysql` container; never published on the host) ───────────────────────────
# Root password of the RADAR MySQL container (used only by the backup container).
MYSQL_ROOT_PASSWORD=
# Database and application user created on first start of an EMPTY volume. Changing them later
# does not rename anything. Defaults: radar / radar.
MYSQL_DATABASE=
MYSQL_USER=
# Password of MYSQL_USER, [A-Za-z0-9_-] only.
MYSQL_PASSWORD=
# Production: leave empty — docker-compose.yml builds it from the MYSQL_* values above.
# Development (.env.local): mysql://root@127.0.0.1:<dev port>/radar
DATABASE_URL=

# ─── AI (optional; everything works with AI off) ─────────────────────────────────────────────
# OpenRouter API key (free tier). Rotate: docs/RECOVERY.md (f).
OPENROUTER_API_KEY=
# Model id. Default: nvidia/nemotron-3-ultra-550b-a55b:free. Test a new model on the golden
# sample before switching (npm run eval / docker compose exec worker radar-entrypoint eval).
OPENROUTER_MODEL=
# true/false. Default: false.
AI_ENABLED=
# Hard cap of AI calls per day (0-1000). Default: 50.
AI_DAILY_LIMIT=

# ─── Alerts (optional; alerts are always stored and shown on /system) ──────────────────────────
# Telegram bot token + chat id. Also used by the backup container for backup/restore failures.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# smtp://user:pass@host:587 or smtps://user:pass@host:465 (URL-encode special characters).
SMTP_URL=
# Recipient of email alerts.
ALERT_EMAIL_TO=
# Optional dead-man's switch (e.g. a healthchecks.io check URL) pinged after each pipeline run.
HEALTHCHECK_PING_URL=

# ─── Backups (the `backup` container; docs/RECOVERY.md) ──────────────────────────────────────
# Passphrase for the encrypted dumps AND for ops/secrets.env.enc, at least 24 characters.
# Store it in your password manager: without it no backup can ever be restored.
BACKUP_PASSPHRASE=
# Where the encrypted dumps are force-pushed. Defaults: git@github.com:Abhi-Ray/Radar.git and
# branch db-backups (the name must contain "backup"; it holds ONE orphan commit).
BACKUP_REPO=
BACKUP_BRANCH=
# Daily backup time, UTC. Defaults: 21 and 0 (21:00 UTC = 02:30 IST).
BACKUP_HOUR_UTC=
BACKUP_MINUTE_UTC=
# Monthly automatic restore test: day of month (1-28) and time, UTC. Defaults: 1, 22, 0.
RESTORE_TEST_DAY=
RESTORE_TEST_HOUR_UTC=
RESTORE_TEST_MINUTE_UTC=
# The restore test fails when the newest backup is older than this. Default: 72.
RESTORE_TEST_MAX_BACKUP_AGE_HOURS=
# Throw-away database the restore test imports into. Default: radar_restore_test.
RESTORE_TEST_DB=
# A backup is refused when it holds fewer than this % of the rows of the stored one
# (protects the off-site copy from an empty database). Default: 50.
BACKUP_SHRINK_GUARD_PCT=
# Dumps larger than this are split into parts (GitHub's file limit is 100 MB).
# Defaults: 47185920 (45 MiB) and 1900000000 (hard maximum).
BACKUP_PART_SIZE=
BACKUP_MAX_SIZE=
# Delay before a missed backup is caught up after a container start, and before the single
# retry of a failed job, in seconds. Defaults: 600 and 3600.
BACKUP_STARTUP_DELAY_SEC=
BACKUP_RETRY_DELAY_SEC=
# Commit author of the backup commits. Defaults: RADAR backup / radar-backup@localhost.invalid.
BACKUP_GIT_NAME=
BACKUP_GIT_EMAIL=
# MySQL account used for dumps/restores. Defaults: root / MYSQL_ROOT_PASSWORD.
BACKUP_DB_USER=
BACKUP_DB_PASSWORD=
